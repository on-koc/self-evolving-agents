{
  "name": "bsk-battery-passive",
  "title": "Battery study with a passive design: fixed nine-point grid, no boundary probes (Basilisk / BSK-RL)",
  "domain": {
    "env_id": "bsk-scan",
    "variables": {
      "battery_capacity_wh": [
        25,
        35.4,
        50,
        70.7,
        100,
        141,
        200,
        283,
        400
      ]
    }
  },
  "hypotheses": [
    {
      "statement": "A lower charge threshold collects more data.",
      "intervention": {
        "charge_below": 0.1
      },
      "baseline": {
        "charge_below": 0.25
      },
      "author": "seed (hand-written)",
      "mechanisms": [
        {
          "statement": "less time is spent in charge mode",
          "mediator": "time_charge_s",
          "mediator_direction": -1
        }
      ]
    },
    {
      "statement": "Topping up the battery before each eclipse improves the score.",
      "intervention": {
        "precharge_window_s": 900,
        "precharge_below": 0.6
      },
      "baseline": {
        "precharge_window_s": 0,
        "precharge_below": 0
      },
      "author": "seed (hand-written)",
      "mechanisms": [
        {
          "statement": "the battery does not get as low",
          "mediator": "min_battery",
          "mediator_direction": 1
        },
        {
          "statement": "it prevents battery depletion",
          "mediator": "failure:battery",
          "mediator_direction": -1
        }
      ]
    },
    {
      "statement": "Unloading the reaction wheels early improves the score.",
      "intervention": {
        "desat_above": 0.3
      },
      "baseline": {
        "desat_above": 0.6
      },
      "author": "seed (hand-written)",
      "mechanisms": [
        {
          "statement": "it prevents the wheels from reaching their speed limit",
          "mediator": "failure:wheels",
          "mediator_direction": -1
        },
        {
          "statement": "slower wheels draw less power, so less time is spent charging",
          "mediator": "time_charge_s",
          "mediator_direction": -1,
          "moderator": "max_wheel_speed_rpm",
          "moderator_direction": 1
        }
      ]
    },
    {
      "statement": "Charging in longer blocks improves the score.",
      "intervention": {
        "charge_margin": 0.25
      },
      "baseline": {
        "charge_margin": 0.0
      },
      "author": "seed (hand-written)",
      "mechanisms": [
        {
          "statement": "fewer mode switches waste less scan time on slewing and settling",
          "mediator": "wasted_scan_s",
          "mediator_direction": -1
        }
      ]
    }
  ],
  "ladders": {
    "charge_below": [
      0.05,
      0.1,
      0.25,
      0.4,
      0.6,
      0.8
    ]
  },
  "sweeps": {
    "max_wheel_speed_rpm": [
      1500,
      3000,
      6000
    ]
  },
  "tester": {
    "batch": 16,
    "max_seeds": 48,
    "seed_base": 1000
  },
  "planner": {
    "boundaries": false
  },
  "budget": 7200,
  "per_round": 4,
  "evaluation": {
    "test_points": {
      "interpolation (inside the studied range)": [
        {
          "battery_capacity_wh": 35
        },
        {
          "battery_capacity_wh": 70
        },
        {
          "battery_capacity_wh": 140
        },
        {
          "battery_capacity_wh": 280
        }
      ],
      "extrapolation (outside the studied range)": [
        {
          "battery_capacity_wh": 18
        },
        {
          "battery_capacity_wh": 600
        }
      ]
    },
    "seeds": [
      5000,
      5032
    ],
    "oracle_grid": {
      "charge_below": [
        0.05,
        0.1,
        0.25,
        0.4,
        0.6,
        0.8
      ],
      "desat_above": [
        0.3,
        0.6
      ]
    },
    "tuning_seeds": [
      6000,
      6016
    ]
  }
}
