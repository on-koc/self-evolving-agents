{
  "name": "bsk-battery-panel",
  "title": "Charging, desaturation and eclipse strategies across battery size and solar-array area (Basilisk / BSK-RL)",
  "domain": {
    "env_id": "bsk-scan",
    "variables": {
      "battery_capacity_wh": [
        25,
        50,
        100,
        200,
        400
      ],
      "panel_area_m2": [
        0.1,
        0.25
      ]
    }
  },
  "hypotheses": [
    {
      "statement": "A lower charge threshold collects more data.",
      "intervention": {
        "charge_below": 0.1
      },
      "baseline": {
        "charge_below": 0.25
      },
      "author": "seed (hand-written)",
      "mechanisms": [
        {
          "statement": "less time is spent in charge mode",
          "mediator": "time_charge_s",
          "mediator_direction": -1
        }
      ]
    },
    {
      "statement": "Topping up the battery before each eclipse improves the score.",
      "intervention": {
        "precharge_window_s": 900,
        "precharge_below": 0.6
      },
      "baseline": {
        "precharge_window_s": 0,
        "precharge_below": 0
      },
      "author": "seed (hand-written)",
      "mechanisms": [
        {
          "statement": "the battery does not get as low",
          "mediator": "min_battery",
          "mediator_direction": 1
        },
        {
          "statement": "it prevents battery depletion",
          "mediator": "failure:battery",
          "mediator_direction": -1
        }
      ]
    },
    {
      "statement": "Unloading the reaction wheels early improves the score.",
      "intervention": {
        "desat_above": 0.3
      },
      "baseline": {
        "desat_above": 0.6
      },
      "author": "seed (hand-written)",
      "mechanisms": [
        {
          "statement": "it prevents the wheels from reaching their speed limit",
          "mediator": "failure:wheels",
          "mediator_direction": -1
        },
        {
          "statement": "slower wheels draw less power, so less time is spent charging",
          "mediator": "time_charge_s",
          "mediator_direction": -1,
          "moderator": "max_wheel_speed_rpm",
          "moderator_direction": 1
        }
      ]
    },
    {
      "statement": "Charging in longer blocks improves the score.",
      "intervention": {
        "charge_margin": 0.25
      },
      "baseline": {
        "charge_margin": 0.0
      },
      "author": "seed (hand-written)",
      "mechanisms": [
        {
          "statement": "fewer mode switches waste less scan time on slewing and settling",
          "mediator": "wasted_scan_s",
          "mediator_direction": -1
        }
      ]
    }
  ],
  "ladders": {
    "charge_below": [
      0.05,
      0.1,
      0.25,
      0.4,
      0.6,
      0.8
    ]
  },
  "sweeps": {
    "max_wheel_speed_rpm": [
      1500,
      3000,
      6000
    ]
  },
  "tester": {
    "batch": 16,
    "max_seeds": 48,
    "seed_base": 1000
  },
  "planner": {
    "boundary_ratio": 1.3,
    "boundary_ratios": {
      "panel_area_m2": 3.0
    }
  },
  "graph": {
    "max_depth": 8
  },
  "budget": 10000,
  "per_round": 4,
  "evaluation": {
    "test_points": {
      "interpolation: untested battery sizes at the small array": [
        {
          "battery_capacity_wh": 35,
          "panel_area_m2": 0.1
        },
        {
          "battery_capacity_wh": 70,
          "panel_area_m2": 0.1
        },
        {
          "battery_capacity_wh": 140,
          "panel_area_m2": 0.1
        },
        {
          "battery_capacity_wh": 280,
          "panel_area_m2": 0.1
        }
      ],
      "interpolation: array areas between the two studied": [
        {
          "battery_capacity_wh": 35,
          "panel_area_m2": 0.16
        },
        {
          "battery_capacity_wh": 70,
          "panel_area_m2": 0.13
        },
        {
          "battery_capacity_wh": 140,
          "panel_area_m2": 0.2
        },
        {
          "battery_capacity_wh": 280,
          "panel_area_m2": 0.16
        }
      ],
      "extrapolation: array areas outside the studied range": [
        {
          "battery_capacity_wh": 140,
          "panel_area_m2": 0.07
        },
        {
          "battery_capacity_wh": 140,
          "panel_area_m2": 0.4
        }
      ]
    },
    "seeds": [
      5000,
      5032
    ],
    "oracle_grid": {
      "charge_below": [
        0.05,
        0.1,
        0.25,
        0.4,
        0.6,
        0.8
      ],
      "desat_above": [
        0.3,
        0.6
      ]
    },
    "tuning_seeds": [
      6000,
      6016
    ]
  }
}